enum OriginalVsSource {
  DEANNE_ORIGINAL
  OUTSIDE_SOURCE
  MIXED
  UNKNOWN
}

enum Publishability {
  PUBLIC_READY
  INTERNAL_ONLY
  CLINICAL_RESTRICTED
  REFERENCE_ONLY
  DO_NOT_PUBLISH
