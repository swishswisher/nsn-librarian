generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LibraryBatchStatus {
  DRAFT
  INGESTING
  READY
  FAILED
  ARCHIVED
}

enum LibrarySourceType {
  LOCAL_UPLOAD
  MAC_BRIDGE
  ZIP_IMPORT
  MANUAL
  EXTERNAL_DRIVE
  UNKNOWN
}

enum KnowledgeItemKind {
  DOCUMENT
  IMAGE
  AUDIO
  VIDEO
  EMAIL
  PRESENTATION
  SPREADSHEET
  ARCHIVE
  UNKNOWN
}

enum ExtractionStatus {
  PENDING
  EXTRACTING
  COMPLETED
  FAILED
  UNSUPPORTED
}

enum ClassificationStatus {
  PENDING
  CLASSIFIED
  NEEDS_REVIEW
  FAILED
  SKIPPED
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum DocumentPrimaryType {
  ARTICLE_CANDIDATE
  NEWSLETTER_CANDIDATE
  WORKSHEET
  CLINICAL_TOOL
  CLINICAL_ASSESSMENT
  RESEARCH_SOURCE
  BOOK_REFERENCE
  THOUGHT_BANK
  CONCEPT_SEED
  WEBSITE_CONTENT
  MEDIA_ASSET
