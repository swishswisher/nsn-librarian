DATABASE_URL=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NSN_LIBRARIAN_APP_URL=http://localhost:3000

# Private Google sign-in. Keep these values server-side only.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NSN_AUTH_SESSION_HOURS=8
# One or two exact approved Google accounts. googleSubject is optional but can be added after confirming the account's stable Google subject ID.
NSN_AUTH_ALLOWED_USERS_JSON=[]

NSN_BRIDGE_PAIRING_SECRET=
NSN_BRIDGE_COMMAND_SIGNING_SECRET=
NSN_BRIDGE_RELEASE_MANIFEST_JSON=
NSN_LOCAL_BRIDGE_URL=http://127.0.0.1:4777
NSN_BRIDGE_PORT=4777
NSN_BRIDGE_DATA_DIR=
NSN_BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hidden automated-test fallback only. Leave unset for normal use.
NSN_ENABLE_DEVELOPER_BRIDGE_FALLBACK=false
NSN_BRIDGE_TEST_FOLDER=
NSN_VIDEO_FFMPEG_PATH=
NSN_VIDEO_FFPROBE_PATH=
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
