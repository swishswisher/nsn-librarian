{
  "name": "nsn-library-machine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/bridge",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:bridge": "tsx apps/bridge/src/main/dev.ts",
    "dev:all": "tsx bridge-app/src/main/dev-all.ts",
    "build": "prisma generate && next build",
    "build:web": "prisma generate && next build",
    "build:bridge": "tsc --project apps/bridge/tsconfig.json --noEmit",
    "package:bridge:mac": "node scripts/package-bridge-mac.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:auth": "node --env-file-if-exists=.env --test --import tsx tests/integration/human-auth.test.ts",
    "test:bridge": "node --env-file-if-exists=.env --test --import tsx bridge-app/tests/*.test.ts tests/integration/connected-libraries-reconnect.test.ts tests/integration/connected-library-file-resolver.test.ts tests/integration/connected-library-batch.test.ts tests/integration/scanned-file-image-filters.test.ts tests/integration/image-intelligence-processing.test.ts tests/integration/knowledge-graph-workflow-noise.test.ts tests/integration/connected-library-execution.test.ts",
    "test:execution": "node --env-file-if-exists=.env --test --import tsx tests/integration/connected-library-execution.test.ts",
    "test:memory": "node --env-file-if-exists=.env --test --import tsx tests/integration/librarian-memory-builder.test.ts",
    "test:protocol": "node --env-file-if-exists=.env --test --import tsx tests/integration/bridge-cloud-protocol.test.ts tests/integration/bridge-cloud-coordinator.test.ts tests/integration/bridge-device-auth.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "41.10.3",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
