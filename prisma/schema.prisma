enum ObservationSessionStatus {
  NEW
  AWAITING_REVIEW
  IN_REVIEW
  APPROVED
  MODIFIED
  REJECTED
  ARCHIVED
}

enum HumanDecisionType {
  ACCEPT
  MODIFY
  REJECT
  NOTE
}

enum KnowledgeConnectionStatus {
  NEW
  CONFIRMED
  REJECTED
  ARCHIVED
}

enum MemoryType {
  THEME
  TERM
  PREFERENCE
  RELATIONSHIP
