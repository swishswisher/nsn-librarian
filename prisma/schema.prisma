  WEBSITE_CANDIDATE
  APPROVED_FOR_PUBLIC_USE
}

enum ImageProcessingStatus {
  NOT_REQUESTED
  PROCESSING
  COMPLETED
  UNAVAILABLE
  FAILED
}

enum ImagePrivacyState {
  PRIVATE
